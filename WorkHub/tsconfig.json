{
    "extends": "./node_modules/pcf-scripts/tsconfig_base.json",
    "compilerOptions": {
        "typeRoots": ["node_modules/@types"],
        "strict": true,
        "jsx": "react-jsx",
        "target": "ES2021",
        "lib": ["ES2021", "DOM"],
        "skipLibCheck": true
    },
    "include": ["WorkHub/**/*.ts", "WorkHub/**/*.tsx", "preview/**/*.tsx"],
    "exclude": ["node_modules", "out"]
}
